# LLM provider (any OpenAI-compatible endpoint; defaults to OpenRouter)
LLM_API_KEY=sk-or-v1-...
LLM_MODEL=google/gemma-4-31b-it:free
# LLM_BASE_URL=https://openrouter.ai/api/v1
# Examples of overrides:
#   LLM_BASE_URL=http://localhost:11434/v1           # local Ollama
#   LLM_BASE_URL=http://localhost:8000/v1            # local vLLM
#   LLM_BASE_URL=https://api.together.xyz/v1         # Together
#   LLM_BASE_URL=https://api.groq.com/openai/v1      # Groq

# Atlassian Cloud
JIRA_BASE_URL=https://yourname.atlassian.net
JIRA_EMAIL=you@example.com
JIRA_API_TOKEN=...
